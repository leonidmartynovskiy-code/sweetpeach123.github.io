---
import LocalServiceTemplate from '../../../components/LocalServiceTemplate.astro';
import { CITIES, type City } from '../../../data/cities';

export function getStaticPaths() {
  return CITIES.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };

const SERVICE = { name: 'Natural stone hardscapes', label: 'Natural stone', slug: 'natural-stone' };

const SERVICES = [
  { label: 'Driveways', slug: 'driveways' },
  { label: 'Walkways', slug: 'walkways' },
  { label: 'Patios', slug: 'patios' },
  { label: 'Pool decks', slug: 'pool-decks' },
  { label: 'Outdoor living', slug: 'outdoor-living' },
  { label: 'Retaining & seating walls', slug: 'retaining-seating-walls' },
  { label: 'Natural stone', slug: 'natural-stone' },
  { label: 'Clean & seal', slug: 'clean-seal' },
];
const CITY_CHIPS = CITIES.map((c) => ({ label: c.name, slug: c.slug }));

// ---- Per-city natural-stone copy (uniquely written off each city's real differentiators) ----
interface Local { lede: string; intro: string[]; localNote: string; faqs: { q: string; a: string }[]; }
const LOCAL: Record<string, Local> = {
  'boca-raton': {
    lede: "For a Boca Raton natural stone patio or pool surround, compare the actual stone, finish and care requirements before choosing by appearance alone.",
    intro: [
      'Boca Raton is one of South Florida\'s most established addresses, and through East Boca, the Boca Islands and Old Floresta the 1970s–90s homes carry an architecture that natural stone suits far better than a manufactured paver. Travertine, marble and shellstone give a custom, high-end look that a mold-made unit cannot copy, and we help you choose and source the right stone for the house rather than the nearest pallet.',
      "For an East Boca coastal setting, ask the supplier to confirm that the proposed stone and any treatment suit the exposure at your property. Some stones do not require sealing; where an impregnating treatment is appropriate, it improves stain resistance without making the surface stain-proof. A stone name or a sealer is not a guarantee against salt damage, etching or a hot surface. Review samples, product care instructions and the planned drainage before ordering.",
      'Whether you are on a non-HOA street in East Boca or inside a gated club like Royal Palm Yacht & Country Club, we handle the paperwork — the City of Boca Raton permit, the drainage slope, and the architectural review submittal with a stone palette the club will approve.',
    ],
    localNote: "For a coastal or canal-front Boca property, bring photos of drainage and exposure conditions plus any existing stone or sealer records. Include the proposed material, finish and care requirements in the estimate.",
    faqs: [
      { q: 'Does salt air near the Boca coast ruin natural stone?', a: "Do not assume that sealing makes stone immune to a coastal setting. Confirm the actual stone and treatment with the supplier for your exposure. An impregnating treatment can improve stain resistance, but it does not replace suitable material selection, drainage or ongoing care." },
      { q: 'Do you work inside the gated communities in Boca Raton?', a: 'Yes. We prepare the architectural review board package for gated clubs like Royal Palm Yacht & Country Club with a stone type, finish and color the board will approve, then pull the City of Boca Raton permit once the community signs off.' },
      { q: 'Is natural stone cooler underfoot than pavers around a coastal pool?', a: "We do not guarantee barefoot comfort from the name travertine or shellstone. Compare the proposed samples in the sun and shade at your pool area, and discuss the finish and intended use before selection." },
      { q: 'What does a natural stone hardscape cost?', a: 'It depends on the stone, the area and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  jupiter: {
    lede: "Jupiter's gated golf and waterfront communities each run a review board, and natural stone gives you a custom look inside a strict palette — we get the stone approved for you.",
    intro: [
      "From Admirals Cove to the Loxahatchee Club, most of Jupiter's target homes are 1990s–2000s builds inside gated golf and waterfront communities. Natural stone is how you set a home apart on a street where every house was built to a similar spec — travertine, marble and flagstone bring a custom, high-end character that a standard community paver simply does not.",
      'The catch in Jupiter is the architectural review board. Nearly every community here has one, and it decides the color, finish and material you are allowed. We prepare the ARB submittal with the exact stone type, finish and honed-versus-tumbled detail so it clears the first time, then pull the Town of Jupiter permit.',
      "For a Jupiter waterfront terrace, confirm the selected stone and finish for outdoor wet use and the actual exposure. Ask for supplier guidance on traction, cleaning and any proposed sealer. A treatment may improve stain resistance, but it cannot establish that the surface will remain cool, resist every salt exposure or prevent slips. Drainage and the condition of the base need their own assessment.",
    ],
    localNote: "Bring your community design guidelines, proposed stone samples and photos of the waterfront exposure. Confirm the material, finish, drainage and maintenance requirements before finalizing the scope.",
    faqs: [
      { q: 'Will you get the natural stone approved by my Jupiter community board?', a: 'Yes — that is a standard part of the job here. We prepare the ARB package with the stone type, finish and color, get the community sign-off, and only then source the material and pull the Town of Jupiter permit.' },
      { q: 'Can natural stone still fit a strict community palette?', a: 'It can. Bring us the ARB guidelines and we spec a travertine, marble or flagstone in an approved color and finish that meets the palette while still reading as a custom, high-end surface unique to your home.' },
      { q: 'Honed or tumbled finish for a Jupiter waterfront home?', a: "Choose using the exact product and its intended use, not honed or tumbled as a safety rating. Ask the supplier for wet-use guidance and test information for the proposed finish and treatment. Consider drainage and maintenance as well as appearance; a test result does not guarantee that a slip cannot occur." },
      { q: 'What does a natural stone hardscape cost?', a: 'It depends on the stone, the area and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  'palm-beach-gardens': {
    lede: "PGA National, BallenIsles, Frenchman's Creek — the Gardens' golf communities run strict design guidelines, and natural stone earns its keep as the upgrade that clears the committee.",
    intro: [
      "Palm Beach Gardens grew up around golf — PGA National, BallenIsles, Frenchman's Creek, Mirasol — and those 1990s–2000s homes have reached the age where the hardscape is ready for a redo. Natural stone is the single biggest lift you can give a terrace or entry in a community where every house is judged against its neighbor, and travertine or marble reads a class above the community paver.",
      'The design guidelines here are strict. Communities in the Gardens often dictate the color family and finish to keep the streetscape consistent, so the work is choosing a stone that satisfies the committee and still sets your home apart. We build the stone palette, the finish and the pattern into the submittal from the start.',
      "The base and drainage need to suit the ground, loads and proposed stone at your property. Ask the stone supplier whether the selected material needs an impregnating treatment and which cleaners are compatible. Where used, the treatment improves stain resistance rather than guaranteeing sun protection or eliminating maintenance. Coordinate the material and finish with the property review requirements before work starts.",
    ],
    localNote: "Bring any community design guidelines and the proposed stone palette to the visit. Include the finish, installation scope and supplier-recommended care in the plan submitted for review.",
    faqs: [
      { q: 'Does my Palm Beach Gardens community have to approve natural stone?', a: 'Almost certainly yes — communities like PGA National and BallenIsles run design committees that approve material, color and finish. We prepare and submit that stone package for you, then pull the City permit once it clears.' },
      { q: 'Why choose natural stone over the community paver here?', a: 'Travertine, marble and flagstone give a custom, high-end look that a mold-made paver cannot match, which matters on a street where curb appeal is judged against every neighbor. We spec a stone that clears the committee and still stands out.' },
      { q: 'How much upkeep does natural stone need in the Gardens?', a: "Care depends on the stone, finish, exposure and any treatment already present. Some stones do not need sealing. Where a sealer is appropriate, follow its product-specific maintenance and reapplication guidance instead of assuming the same schedule for every stone. Ask which cleaners are suitable and address spills promptly." },
      { q: 'What does a natural stone hardscape cost?', a: 'It depends on the stone, the area and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  wellington: {
    lede: "Out on Wellington's equestrian acreage the stone terraces run estate-scale, and natural stone is what turns a large hardscape into a statement that fits the property.",
    intro: [
      'Wellington is a different kind of stone job. Out on the acreage of Palm Beach Point, the Aero Club and Grand Prix Village, the hardscapes run large — sweeping terraces, entries and pool surrounds on estate lots — and natural stone is what carries that scale. Travertine and flagstone give an estate-grade, custom look across a big footprint that a manufactured paver would only make feel ordinary.',
      'The scale is the opportunity and the discipline. A large stone terrace needs a base built for the load and the ground movement, and it needs enough material sourced from the same lots to keep the color consistent across the run. We plan the sourcing and the drainage across the whole area so the field reads as one, not a patchwork.',
      "Compare the proposed stone and finish with the architecture and how each part of the terrace will be used. For a large Wellington project, include stone identification, cleaning requirements and any recommended treatment in the written scope. Some stones do not need sealing; where appropriate, an impregnating treatment improves stain resistance, with care and reapplication based on supplier guidance and condition.",
    ],
    localNote: 'Estate-scale stone terraces need material sourced consistently across a large run and a base built for the load — we plan the sourcing and grade the drainage across the full acreage.',
    faqs: [
      { q: 'Can you keep the color consistent across a large estate stone terrace?', a: 'Yes — that is the discipline on an acreage job. We source enough travertine or flagstone from the same lots up front so the color reads as one field across a big terrace, rather than a patchwork of dye lots.' },
      { q: 'Which natural stone suits a Wellington equestrian estate?', a: 'Flagstone brings a rugged, natural look that suits ranch-style estates and larger grounds, while travertine reads more refined for a formal home and pool surround. We match the stone to the architecture at the visit.' },
      { q: 'Is there an approval step for stone in Wellington?', a: 'It depends on your street — much of the equestrian acreage is non-HOA, while the equestrian villages have their own rules. We confirm which applies, prepare any submittal, and pull the Village of Wellington permit either way.' },
      { q: 'What does a natural stone hardscape cost?', a: 'It depends on the stone, the area and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  'west-palm-beach': {
  "lede": "Plan your natural stone installation around the home you have, including its architectural character, access and the condition of existing surfaces.",
  "intro": [
    "For a West Palm Beach natural stone installation, start with the stone product, finish, use area and cleaning requirements. If your property in El Cid, Flamingo Park or another neighborhood has historic designation, check which features and materials need review before finalizing the design. A neighborhood name alone does not determine the age or requirements of an individual home.",
    "Before finalizing the stone type, finish and installation area, confirm the property address, historic status and any association requirements. The <a href=\"https://www.wpb.org/Departments/Development-Services/Planning-Division/Historic-Preservation/Historic-Preservation-FAQs\">City of West Palm Beach historic preservation guidance</a> explains the additional review for designated properties. Bring a survey, photos and any existing approval documents to the on-site visit so the estimate can reflect the work and review steps.",
    "Choose the stone for its intended use and finish, not only its name. Some stones do not need a sealer, and a compatible impregnating treatment improves stain resistance rather than making stone stain-proof. Confirm cleaning products with the supplier; acidic products can etch calcareous stones such as marble and travertine."
  ],
  "localNote": "Bring a survey, photos and any existing product or approval records. For this West Palm Beach natural stone installation, the estimate should explain the stone product, finish, use area and cleaning requirements, what will be retained and any separate repair allowance.",
  "faqs": [
    {
      "q": "What natural stone suits a historic El Cid or Flamingo Park home?",
      "a": "Compare samples of the proposed stone and finish with your home and any approved palette. Choose the stone for its intended use and finish, not only its name. Some stones do not need a sealer, and a compatible impregnating treatment improves stain resistance rather than making stone stain-proof. Confirm cleaning products with the supplier; acidic products can etch calcareous stones such as marble and travertine."
    },
    {
      "q": "Which approvals apply to this work in West Palm Beach?",
      "a": "Approval depends on the specific property and work, even without an HOA. Check any required city permits and whether historic designation adds review. Discuss the stone type, finish and installation area with the City of West Palm Beach before work begins, and confirm any separate association requirements."
    },
    {
      "q": "Does natural stone hold up on an older in-town lot?",
      "a": "Choose the stone for its intended use and finish, not only its name. Some stones do not need a sealer, and a compatible impregnating treatment improves stain resistance rather than making stone stain-proof. Confirm cleaning products with the supplier; acidic products can etch calcareous stones such as marble and travertine."
    },
    {
      "q": "What does a natural stone hardscape cost?",
      "a": "It depends on the stone, the area and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
    }
  ]
},
  'delray-beach': {
  "lede": "For your Delray Beach natural stone installation, compare the existing condition, material options and maintenance needs before deciding what to replace.",
  "intro": [
    "For a Delray Beach home in Lake Ida, Del-Ida Park or near the coast, assess the stone product, finish, use area and cleaning requirements at the actual property. Exposure, access and the condition of what you want to retain can differ from one lot to the next. An older surface does not by itself establish that full replacement is necessary.",
    "Before finalizing the stone type, finish and installation area, confirm the property address, historic status and any association requirements. The <a href=\"https://www.delraybeachfl.gov/government/city-departments/development-services/historic-preservation/historic-preservation-applications\">City of Delray Beach historic preservation guidance</a> explains the additional review for designated properties. Bring a survey, photos and any existing approval documents to the on-site visit so the estimate can reflect the work and review steps.",
    "Choose the stone for its intended use and finish, not only its name. Some stones do not need a sealer, and a compatible impregnating treatment improves stain resistance rather than making stone stain-proof. Confirm cleaning products with the supplier; acidic products can etch calcareous stones such as marble and travertine."
  ],
  "localNote": "Bring a survey, photos and any existing product or approval records. For this Delray Beach natural stone installation, the estimate should explain the stone product, finish, use area and cleaning requirements, what will be retained and any separate repair allowance.",
  "faqs": [
    {
      "q": "Does salt air near the Delray beach hurt natural stone?",
      "a": "Salt exposure and moisture can affect both stone and concrete products. Select material and any treatment using the supplier instructions for the actual setting. Sealer can improve stain resistance but does not make a surface immune to salt, staining or wear. Cleaning and resealing depend on the product and observed condition."
    },
    {
      "q": "Which approvals apply to this work in Delray Beach?",
      "a": "Approval depends on the specific property and work, even without an HOA. Check any required city permits and whether historic designation adds review. Discuss the stone type, finish and installation area with the City of Delray Beach before work begins, and confirm any separate association requirements."
    },
    {
      "q": "Is natural stone cooler by the pool than pavers?",
      "a": "Surface temperature depends on the particular product, color, finish, sun exposure and weather. Compare samples at your property in the conditions you expect to use the area. A stone name alone does not guarantee barefoot comfort; plan shade and appropriate footwear as needed."
    },
    {
      "q": "What does a natural stone hardscape cost?",
      "a": "It depends on the stone, the area and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
    }
  ]
},
  'boynton-beach': {
    lede: "For a Boynton Beach natural stone terrace, review the material, finish and drainage at your property before deciding on installation and ongoing care.",
    intro: [
      "Boynton Beach's best hardscape work is on the water and to the east — the Intracoastal waterfront, Harbor Estates, Chapel Hill, Lake Eden. Many of these homes are 1960s–90s builds ready for an upgrade, and natural stone gives them a premium, custom look: travertine, marble and shellstone read a class above the paver the original builder used.",
      "At a Boynton waterfront property, inspect the actual ground, existing base and drainage instead of assuming conditions from the neighborhood. Confirm the proposed stone and any sealer with the supplier for the exposure and intended use. An impregnating treatment can improve stain resistance; it is not a substitute for drainage or a promise that stone will hold its color under every salt and sun exposure.",
      'Boynton is a mix — some waterfront pockets are non-HOA, some newer streets run an HOA. We confirm which applies, match the stone to the home\'s architecture, prepare the HOA submittal if there is one, and pull the City of Boynton Beach permit either way.',
    ],
    localNote: "Show us where water collects after rain and provide any existing stone or treatment records. The estimate should distinguish base and drainage work from material selection and ongoing surface care.",
    faqs: [
      { q: 'My Boynton home backs onto the Intracoastal — will the salt and water table affect natural stone?', a: "Assess both the exposure and the ground conditions at the actual property. Material and treatment selection need supplier guidance, while drainage and base preparation are separate parts of the installation scope. Sealing alone does not establish that the stone will remain level or retain its color." },
      { q: 'Is there an HOA approval step for stone in Boynton Beach?', a: 'It depends on your street — waterfront pockets are often non-HOA, while newer communities have one. We check first, prepare the HOA stone submittal if it is needed, and pull the City of Boynton Beach permit regardless.' },
      { q: 'Which natural stone suits a 1960s–90s Boynton home?', a: 'Travertine and marble bring a premium, custom look that lifts an older waterfront home a class above its original paver. We match the stone type, tone and finish to the architecture at the on-site visit.' },
      { q: 'What does a natural stone hardscape cost?', a: 'It depends on the stone, the area and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
};

const local = LOCAL[city.slug];
const permit = city.permitAuthority.replace('the ', '').replace(/^./, (m) => m.toUpperCase());
const evidenceRepair = ['west-palm-beach', 'delray-beach'].includes(city.slug);
const handles = [
  `Choosing and sourcing the right travertine, marble, shellstone or flagstone for ${city.name}'s homes, over a compacted base built for the sandy soil`,
  city.hoa === 'property-specific'
    ? 'City, historic-district and association requirements checked for your property and scope'
    : city.hoa === 'none'
    ? 'Any city or historic-district review kept period-appropriate on stone type and finish'
    : city.hoa === 'hoa'
    ? 'Your HOA / architectural review board stone palette prepared and shepherded through'
    : 'HOA or non-HOA — we confirm your street and handle whichever applies',
  `Stone and finish selected for the intended use, with drainage and any supplier-recommended surface treatment included in the written scope`,
];

const data = {
  seoTitle: `Natural Stone Hardscapes in ${city.name}, FL · Perfect Pavers`,
  seoDescription: `Travertine, marble & flagstone hardscapes in ${city.name} — sourced, sealed and set. ${permit} permit and ${city.hoa === 'property-specific' ? 'applicable' : city.hoa === 'none' ? 'district' : 'HOA/ARB'} approval handled. Free on-site visit.`,
  service: SERVICE,
  city,
  lede: local.lede,
  intro: local.intro,
  localNote: local.localNote,
  handles: evidenceRepair ? [
    "Assessment of the stone product, finish, use area and cleaning requirements, with retained materials and repairs identified in the written scope",
    ...handles.slice(1),
  ] : handles,
  faqs: local.faqs,
  heroImg: '/images/local-hero-natural-stone.jpg',
  heroAlt: `Natural stone hardscape in ${city.name}, Palm Beach County`,
  heroBg: '/images/local-hero-natural-stone.jpg',
  services: SERVICES,
  cities: CITY_CHIPS,
};
---
<LocalServiceTemplate {...data} />
