---
import LocalServiceTemplate from '../../../components/LocalServiceTemplate.astro';
import { CITIES, type City } from '../../../data/cities';

export function getStaticPaths() {
  return CITIES.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };

const SERVICE = { name: 'Paver driveways', label: 'Driveways', slug: 'driveways' };

const SERVICES = [
  { label: 'Driveways', slug: 'driveways' },
  { label: 'Walkways', slug: 'walkways' },
  { label: 'Patios', slug: 'patios' },
  { label: 'Pool decks', slug: 'pool-decks' },
  { label: 'Outdoor living', slug: 'outdoor-living' },
  { label: 'Retaining & seating walls', slug: 'retaining-seating-walls' },
  { label: 'Natural stone', slug: 'natural-stone' },
  { label: 'Clean & seal', slug: 'clean-seal' },
];
const CITY_CHIPS = CITIES.map((c) => ({ label: c.name, slug: c.slug }));

// ---- Per-city driveway copy (uniquely written off each city's real differentiators) ----
interface Local { lede: string; intro: string[]; localNote: string; faqs: { q: string; a: string }[]; }
const LOCAL: Record<string, Local> = {
  'boca-raton': {
    lede: 'In East Boca, a lot of driveways were poured when the house went up in the 1970s or 80s — four decades of sun, salt and settling later, they are ready for pavers.',
    intro: [
      'Boca Raton is one of South Florida\'s most established communities, and a large share of its homes — through East Boca, the Boca Islands and Old Floresta — date to the 1970s through 90s. A concrete driveway that old has usually cracked, spalled at the surface, or sunk where the ground settled near a canal. We remove the failing slab, build a proper compacted base, and lay a paver driveway that flexes with the ground instead of cracking with it.',
      'This close to the ocean and the canals, salt air is relentless on a driveway. Sealed pavers shrug off the salt and the afternoon storms, and if a section ever settles near the seawall we lift and reset those pavers rather than patching a slab you can never hide.',
      'Whether you are on a non-HOA street in East Boca or inside a gated club like Royal Palm Yacht & Country Club, we handle the paperwork — the City of Boca Raton permit, the drainage slope, and the architectural review submittal for the clubs that require it.',
      "Preparing approvals? Our <a href=\"/blog/driveway-pavers-boca-raton/\">Boca Raton driveway guide</a> explains how city review and association approval fit into the project.",
    ],
    localNote: "Boca's coastal lots often carry drainage and swale requirements, and canal-front homes can have a low door threshold — we build the slope so water runs to the street or the swale, never back toward the house.",
    faqs: [
      { q: 'Do you work inside the gated communities in Boca Raton?', a: 'Yes. We regularly prepare the architectural review board package for gated clubs like Royal Palm Yacht & Country Club, then pull the City of Boca Raton permit once the community signs off.' },
      { q: 'My driveway is original to my 1980s East Boca home — can it be saved?', a: 'Usually the honest answer is no. A slab that old has cracked and settled, and laying pavers over failing concrete just moves the problem. We remove it, build a fresh compacted base, and you get a driveway that outlasts the next slab by decades.' },
      { q: 'Will pavers crack like my concrete driveway?', a: 'No. Concrete is a single rigid slab, so when the ground shifts it cracks. A paver driveway is individual units over a compacted base, so it flexes with the ground and stays intact — and any piece can be lifted and reset with no visible patch.' },
      { q: 'What does a paver driveway cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  jupiter: {
    lede: "Jupiter's waterfront and golf homes went up in the 1990s and 2000s, and most sit inside a gated community with its own approval board — we take that off your plate.",
    intro: [
      "From Admirals Cove to the Loxahatchee Club, most of Jupiter's target homes are 1990s–2000s builds inside gated golf and waterfront communities. The original driveways are dated rather than destroyed, so the job here is as much about the look — matching the community palette and lifting curb appeal — as it is about the base.",
      'The catch in Jupiter is the architectural review board. Nearly every community here has one, and it decides the color, pattern and border you are allowed. We prepare the ARB submittal with the paver spec and drawings so it clears the first time, then pull the Town of Jupiter permit.',
      'On the water — the Intracoastal, the inlet, the canals — salt and boat-trailer weight both matter. We build the base for the load and seal for the salt, so the apron by the garage holds up to the trailer and the driveway holds its color.',
      "Before changing the street connection, read our <a href=\"/blog/driveway-pavers-jupiter/\">Jupiter driveway and right-of-way guide</a> to separate the private driveway from work near the public road.",
    ],
    localNote: 'Most Jupiter projects run through a community architectural review board before the Town permit — we manage both, and build the drainage to the community grading rules.',
    faqs: [
      { q: 'Will you handle the architectural review board approval in my Jupiter community?', a: 'Yes — that is a standard part of the job here. We prepare the ARB package (paver color, pattern, border and drawings), get the community sign-off, and only then order material and pull the Town of Jupiter permit.' },
      { q: 'Can you match the paver style my community requires?', a: 'We build to the community approved palette. Bring us the guidelines or the ARB requirements and we spec a driveway that meets them while still looking custom to your home.' },
      { q: 'Will pavers crack like my concrete driveway?', a: 'No. A paver driveway is individual units over a compacted base, so it flexes with the ground instead of cracking like a rigid slab — and any piece can be lifted and reset with no visible patch.' },
      { q: 'What does a paver driveway cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  'palm-beach-gardens': {
    lede: "Planning a paver driveway in Palm Beach Gardens? Compare repair and replacement, drainage, vehicle loads and the requirements for your property before choosing materials.",
    intro: [
      "Start with what your driveway needs to do: daily parking, turning space, access to the garage and a clear route for runoff. Show us uneven areas, damaged units and places where water collects. The condition of your driveway, rather than the age of the neighborhood, should guide the choice between a reset and replacement.",
      'The estimate should distinguish removal from work that retains the existing base or pavers. Identify the proposed material, bedding and edge restraints, the transitions at doors and the garage, and any drain or outlet work. Agree how changes discovered during removal will be assessed and priced before that extra work begins.',
      'If your property has an association or architectural review board, bring its current design guidelines and any required material samples or drawings. Confirm the applicable City review for the actual driveway, street connection and drainage scope. The <a href="https://www.pbgfl.gov/DocumentCenter/View/23377/Flatwork-Slab" target="_blank" rel="noopener noreferrer">City flatwork and slab checklist</a> is a general reference, not a substitute for confirming the requirements for your address. The written scope should identify who prepares submissions and handles revisions.',
      'Keeping part of your existing driveway? Our <a href="/blog/matching-new-pavers-existing-driveway/">guide to matching replacement pavers</a> explains what to check before approving new units alongside the old ones.',
    ],
    localNote: 'Bring a survey or previous plans if available, photos of the driveway and drainage, and any association guidelines. Review the material samples, proposed levels and drain outlet together so the estimate describes the work you actually want.',
    faqs: [
      { q: 'Does my Palm Beach Gardens community have to approve the driveway?', a: 'Check the current property and association rules for your address. Where an association review applies, confirm its required colors, patterns and documents separately from City review. Agree who submits each application and handles revisions; the approval and review sequence depend on the actual requirements.' },
      { q: 'Our community pavers are faded and uneven - replace or reset?', a: 'Fading alone does not determine whether a driveway needs replacement. Assess the cause of movement, the base, drainage and the condition of the existing units. Compare the work and appearance expected from a reset with those of replacement, including any matching limitations and repairs outside the paver surface.' },
      { q: 'Will pavers crack like my concrete driveway?', a: 'Individual pavers can crack, settle or become damaged. Whether units can be lifted and reused depends on their condition and the cause of the problem. Replacement units may differ in color, texture and wear; compare actual samples and agree the expected appearance before ordering. An invisible repair is not guaranteed.' },
      { q: 'What does a paver driveway cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  wellington: {
    lede: "Out in Wellington's equestrian estates the driveways are long, the aprons are big, and horse trailers are heavy — this is base-and-load engineering, not just surface.",
    intro: [
      'Wellington is a different kind of driveway job. Out on the acreage of Palm Beach Point, the Aero Club and Grand Prix Village, driveways run long — often a circular drive plus a service apron — and they carry real weight: trucks, horse trailers, feed deliveries. Get the base wrong and you see ruts within a season.',
      'We build these for the load. That means deeper excavation, a thicker compacted rock base and the right paver thickness where trailers turn and park, so the surface stays flat under weight that would rut a thin residential build. On acreage we also plan the drainage across a much larger area.',
      'The scale is the opportunity — a long paver driveway on an estate lot is a statement, and it is where pavers pull the furthest ahead of a poured strip that would crack end to end. We pull the Village of Wellington permit and grade the whole run.',
      "Planning an acreage entrance? Our <a href=\"/blog/driveway-pavers-wellington/\">Wellington driveway planning guide</a> covers truck and trailer access, drainage and the documents to prepare.",
    ],
    localNote: 'Estate driveways carry trailer and truck loads over long runs — we build a deeper base and thicker pavers at the turns and aprons, and grade drainage across the full acreage.',
    faqs: [
      { q: 'My driveway has to take horse trailers and trucks — will pavers hold up?', a: 'Yes, when they are built for it. We increase the base depth and use a thicker paver at the aprons and turning areas so the surface carries trailer and truck weight without rutting — and any spot that ever moves can be reset, unlike a cracked concrete strip.' },
      { q: 'Can you do a long circular driveway on an acre-plus lot?', a: 'That is a big part of what we do in Wellington. Long runs and circular drives are where a paver driveway really shines — we grade the drainage across the whole lot and build the base for the loads an estate driveway actually sees.' },
      { q: 'Will pavers crack like my concrete driveway?', a: 'No. A paver driveway is individual units over a compacted base, so it flexes with the ground instead of cracking like a rigid slab — and any piece can be lifted and reset with no visible patch.' },
      { q: 'What does a paver driveway cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  'west-palm-beach': {
  "lede": "Plan your driveway around the home you have, including its architectural character, access and the condition of existing surfaces.",
  "intro": [
    "For a West Palm Beach driveway, start with vehicle loads, the street connection, garage levels and drainage. If your property in El Cid, Flamingo Park or another neighborhood has historic designation, check which features and materials need review before finalizing the design. A neighborhood name alone does not determine the age or requirements of an individual home.",
    "Before finalizing the driveway layout, material and drainage, confirm the property address, historic status and any association requirements. The <a href=\"https://www.wpb.org/Departments/Development-Services/Planning-Division/Historic-Preservation/Historic-Preservation-FAQs\">City of West Palm Beach historic preservation guidance</a> explains the additional review for designated properties. Bring a survey, photos and any existing approval documents to the on-site visit so the estimate can reflect the work and review steps.",
    "Salt exposure and moisture can affect both stone and concrete products. Select material and any treatment using the supplier instructions for the actual setting. Sealer can improve stain resistance but does not make a surface immune to salt, staining or wear. Cleaning and resealing depend on the product and observed condition. Individual pavers may be lifted and reset, but first identify the cause of movement and whether the units are reusable. Replacement units can differ in color and wear from the existing surface. Repair scope and the likely appearance should be agreed after inspection; an invisible repair is not guaranteed."
  ],
  "localNote": "Bring a survey, photos and any existing product or approval records. For this West Palm Beach driveway, the estimate should explain vehicle loads, the street connection, garage levels and drainage, what will be retained and any separate repair allowance.",
  "faqs": [
    {
      "q": "What paver suits a historic El Cid or Flamingo Park home?",
      "a": "Clay brick and warm-toned pavers in a herringbone or running-bond pattern read true to the 1920s–40s architecture. We help you choose a finish that looks original to the house rather than bolted on."
    },
    {
      "q": "Which approvals apply to this work in West Palm Beach?",
      "a": "Approval depends on the specific property and work, even without an HOA. Check any required city permits and whether historic designation adds review. Discuss the driveway layout, material and drainage with the City of West Palm Beach before work begins, and confirm any separate association requirements."
    },
    {
      "q": "Will pavers crack like my concrete driveway?",
      "a": "Individual pavers may be lifted and reset, but first identify the cause of movement and whether the units are reusable. Replacement units can differ in color and wear from the existing surface. Repair scope and the likely appearance should be agreed after inspection; an invisible repair is not guaranteed."
    },
    {
      "q": "What does a paver driveway cost?",
      "a": "It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
    }
  ]
},
  'delray-beach': {
  "lede": "For your Delray Beach driveway, compare the existing condition, material options and maintenance needs before deciding what to replace.",
  "intro": [
    "For a Delray Beach home in Lake Ida, Del-Ida Park or near the coast, assess vehicle loads, the street connection, garage levels and drainage at the actual property. Exposure, access and the condition of what you want to retain can differ from one lot to the next. An older surface does not by itself establish that full replacement is necessary.",
    "Before finalizing the driveway layout, material and drainage, confirm the property address, historic status and any association requirements. The <a href=\"https://www.delraybeachfl.gov/government/city-departments/development-services/historic-preservation/historic-preservation-applications\">City of Delray Beach historic preservation guidance</a> explains the additional review for designated properties. Bring a survey, photos and any existing approval documents to the on-site visit so the estimate can reflect the work and review steps.",
    "Salt exposure and moisture can affect both stone and concrete products. Select material and any treatment using the supplier instructions for the actual setting. Sealer can improve stain resistance but does not make a surface immune to salt, staining or wear. Cleaning and resealing depend on the product and observed condition. Individual pavers may be lifted and reset, but first identify the cause of movement and whether the units are reusable. Replacement units can differ in color and wear from the existing surface. Repair scope and the likely appearance should be agreed after inspection; an invisible repair is not guaranteed."
  ],
  "localNote": "Bring a survey, photos and any existing product or approval records. For this Delray Beach driveway, the estimate should explain vehicle loads, the street connection, garage levels and drainage, what will be retained and any separate repair allowance.",
  "faqs": [
    {
      "q": "Does salt air near the Delray beach hurt a paver driveway?",
      "a": "Salt exposure and moisture can affect both stone and concrete products. Select material and any treatment using the supplier instructions for the actual setting. Sealer can improve stain resistance but does not make a surface immune to salt, staining or wear. Cleaning and resealing depend on the product and observed condition."
    },
    {
      "q": "Which approvals apply to this work in Delray Beach?",
      "a": "Approval depends on the specific property and work, even without an HOA. Check any required city permits and whether historic designation adds review. Discuss the driveway layout, material and drainage with the City of Delray Beach before work begins, and confirm any separate association requirements."
    },
    {
      "q": "Will pavers crack like my concrete driveway?",
      "a": "Individual pavers may be lifted and reset, but first identify the cause of movement and whether the units are reusable. Replacement units can differ in color and wear from the existing surface. Repair scope and the likely appearance should be agreed after inspection; an invisible repair is not guaranteed."
    },
    {
      "q": "What does a paver driveway cost?",
      "a": "It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
    }
  ]
},
  'boynton-beach': {
    lede: "Along the Intracoastal and Boynton's eastern streets, driveways see salt and settle near the water — pavers handle both.",
    intro: [
      "Boynton Beach's best hardscape work is on the water and to the east — the Intracoastal waterfront, Harbor Estates, Chapel Hill, Lake Eden. Many of these homes are 1960s–90s builds whose original driveways have cracked and settled, and they are ready for an upgrade.",
      'Near the Intracoastal, salt and a high water table both work against a slab. We build the base for ground that stays damp, seal the pavers against the salt, and set the drainage so summer downpours run off instead of pooling by the garage.',
      'Boynton is a mix — some waterfront pockets are non-HOA, some newer streets run an HOA. We confirm which applies to you, prepare the HOA submittal if there is one, and pull the City of Boynton Beach permit either way.',
      'Planning the entrance? Read our guide to <a href="/blog/driveway-flare-boynton-beach/">the 5-by-10-foot driveway flare in Boynton Beach</a> before choosing the border and measuring the work.',
      'Planning work near the street? Read about <a href="/blog/pavers-hold-harmless-boynton-beach/">Boynton Beach pavers and restoration responsibility</a> before finalizing the scope.',
    ],
    localNote: 'Waterfront lots near the Intracoastal sit on a higher water table — we build the base for damp ground, seal against salt, and grade so heavy rain drains away from the home.',
    faqs: [
      { q: 'My Boynton home backs onto the Intracoastal — does the water table matter?', a: 'It does. A high water table near the water makes a solid, well-compacted base essential, which is exactly what we build. Pavers over that base handle the damp ground and let you reset any section that ever settles by the seawall.' },
      { q: 'Is there an HOA approval step in Boynton Beach?', a: 'It depends on your street — waterfront pockets are often non-HOA, while newer communities have one. We check first, prepare the HOA package if it is needed, and pull the City of Boynton Beach permit regardless.' },
      { q: 'Will pavers crack like my concrete driveway?', a: 'No. A paver driveway is individual units over a compacted base, so it flexes with the ground instead of cracking like a rigid slab — and any piece can be lifted and reset with no visible patch.' },
      { q: 'What does a paver driveway cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
};

const local = LOCAL[city.slug];
const gardens = city.slug === 'palm-beach-gardens';
const permit = city.permitAuthority.replace('the ', '').replace(/^./, (m) => m.toUpperCase());
const evidenceRepair = ['west-palm-beach', 'delray-beach'].includes(city.slug);
const handles = [
  `Removal of the failing driveway and a compacted rock base built for ${city.name}'s sandy soil`,
  city.hoa === 'property-specific'
    ? 'City, historic-district and association requirements checked for your property and scope'
    : city.hoa === 'none'
    ? 'Any city or historic-district review kept period-appropriate'
    : city.hoa === 'hoa'
    ? 'Your HOA / architectural review board submittal prepared and shepherded through'
    : 'HOA or non-HOA — we confirm your street and handle whichever applies',
  `${permit} permit pulled, with drainage and slope built to local code`,
];

const data = {
  seoTitle: `Paver Driveways in ${city.name}, FL · Perfect Pavers`,
  seoDescription: gardens ? "Plan your Palm Beach Gardens paver driveway: compare repair or replacement, materials, drainage and property-specific approvals. Request a free on-site visit." : `Custom paver driveways in ${city.name} — proper rock base, drainage and edge restraints. ${permit} permit and ${city.hoa === 'property-specific' ? 'applicable' : city.hoa === 'none' ? 'district' : 'HOA/ARB'} approval handled. Free on-site visit.`,
  service: SERVICE,
  city: gardens ? { ...city, homeEra: 'Existing homes', setting: 'driveway condition assessed on site', blurb: 'Plan a driveway around the actual parking, garage access and drainage needs of your Palm Beach Gardens property. Confirm any association design requirements before choosing the finish.' } : city,
  approvalsLabel: gardens ? 'Confirm city / association requirements' : undefined,
  lede: local.lede,
  intro: local.intro,
  localNote: local.localNote,
  handles: gardens ? [
    'Assessment of vehicle loads, garage and entry levels, existing pavers, base condition and drainage before choosing a reset or replacement',
    'Written scope separating removal, retained materials, new pavers, drainage work and responsibility for unexpected conditions',
    'Applicable City and association submissions identified for the address and scope, with responsibilities agreed before work begins',
  ] : evidenceRepair ? [
    "Assessment of vehicle loads, the street connection, garage levels and drainage, with retained materials and repairs identified in the written scope",
    ...handles.slice(1),
  ] : handles,
  faqs: local.faqs,
  heroImg: '/images/pf-driveway.jpg',
  heroAlt: gardens ? 'Paver driveway surface detail' : `Paver driveway in ${city.name}, Palm Beach County`,
  heroBg: '/images/local-hero-driveways.jpg',
  services: SERVICES,
  cities: CITY_CHIPS,
};
---
<LocalServiceTemplate {...data} />
