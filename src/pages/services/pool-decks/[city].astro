const local = LOCAL[city.slug];
const handles = [
  'Assessment of coping, door clearances, drainage, pool equipment and wet-use conditions, with retained materials and repairs identified in the written scope',
  'Applicable city and association reviews checked for the address and scope, with submission responsibilities identified before work begins',
  'Material, finish and any surface treatment selected using supplier guidance for poolside use; preparation, drainage and care requirements included in the estimate',
];

const data = {
  seoTitle: `Paver Pool Decks in ${city.name}, FL · Perfect Pavers`,
  seoDescription: `Paver pool decks in ${city.name}: compare materials, coping, drainage and site preparation. Request a free on-site assessment.`,
  service: SERVICE,
  city,
  lede: local.lede,
  intro: local.intro,
  localNote: local.localNote,
  handles,
  faqs: local.faqs,
  heroImg: '/images/local-hero-pool-decks.jpg',
  heroAlt: 'Pool deck paver example; not a verified project at this location',
  heroBg: '/images/local-hero-pool-decks.jpg',
  services: SERVICES,
  cities: CITY_CHIPS,
};
---
<LocalServiceTemplate {...data} />
