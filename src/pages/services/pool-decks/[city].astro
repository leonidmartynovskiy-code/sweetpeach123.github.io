---
import LocalServiceTemplate from '../../../components/LocalServiceTemplate.astro';
import { CITIES, type City } from '../../../data/cities';

export function getStaticPaths() {
  return CITIES.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };

const SERVICE = { name: 'Paver pool decks', label: 'Pool decks', slug: 'pool-decks' };

const SERVICES = [
  { label: 'Driveways', slug: 'driveways' },
  { label: 'Walkways', slug: 'walkways' },
  { label: 'Patios', slug: 'patios' },
  { label: 'Pool decks', slug: 'pool-decks' },
  { label: 'Outdoor living', slug: 'outdoor-living' },
  { label: 'Retaining & seating walls', slug: 'retaining-seating-walls' },
  { label: 'Natural stone', slug: 'natural-stone' },
  { label: 'Clean & seal', slug: 'clean-seal' },
];
const CITY_CHIPS = CITIES.map((c) => ({ label: c.name, slug: c.slug }));

// ---- Per-city pool-deck copy (uniquely written off each city's real differentiators) ----
interface Local { lede: string; intro: string[]; localNote: string; faqs: { q: string; a: string }[]; }
const LOCAL: Record<string, Local> = {
  'boca-raton': {
    lede: "Planning a Boca Raton pool deck replacement? Compare the existing deck, coping and drainage before choosing the new pavers and finish.",
    intro: [
      "For a Boca Raton pool deck, start with the condition of the existing surface and the transitions to your pool and home. Identify uneven areas, cracked units and water that collects after rain. The assessment should distinguish reusable pavers from areas needing removal or base work; the age or neighborhood of a home alone does not establish the repair scope.",
      "For a coastal or canal-front pool, check the proposed stone, finish and any surface treatment with the supplier for the actual exposure and poolside use. Sealing may improve stain resistance, but it is not a guarantee against salt or chemical damage. Discuss how the coping meets the new deck and how any retained units will look beside replacements.",
      "Bring a survey, pool and deck photos, any previous permits and your association guidelines, if applicable. Before work begins, confirm which city and association reviews apply to the proposed deck, drainage and pool-barrier changes. The written estimate should identify the work included and who will supply any required review documents.",
    ],
    localNote: "For your Boca property, show us low spots and the transitions at doors, coping and existing drains. Confirm the proposed drainage route and any site-specific review requirements before finalizing the layout.",
    faqs: [
      { q: 'Which pavers stay cool enough to walk on barefoot around a Boca pool?', a: "Compare the actual product, color and finish in the sun and shade where it will be installed. A stone name alone does not guarantee barefoot comfort. Ask for supplier guidance for wet poolside use and any proposed treatment; texture and a test result do not guarantee that a slip cannot occur." },
      { q: 'My deck has settled and cracked against the pool near a canal — can it be reset?', a: "It depends on the cause of the movement and the condition of the base, pavers and pool edge. Identify those issues before deciding between a local reset and replacement. Ask which units can be reused and whether replacements will differ in color or wear; a flush or invisible repair should not be promised before inspection." },
      { q: 'Will a salt-chlorine pool damage a paver deck?', a: "Do not assume that a sealer makes travertine or marble immune to pool chemicals or salt. Confirm compatibility and maintenance with the stone and treatment suppliers. Sealer selection is separate from correcting settlement or drainage; agree the likely repair appearance after assessing the existing units." },
      { q: 'What does a paver pool deck cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  jupiter: {
    lede: "Plan your Jupiter pool deck around wet-use conditions, coping, drainage and any property-specific design requirements.",
    intro: [
      "For a Jupiter pool surround, compare the features you want to retain with what needs repair or replacement. Bring photos of the deck, coping, doors and equipment access. Choose the stone and finish for the way the space will be used, then compare samples on site rather than assuming travertine or marble will always feel cool.",
      "If your property has an architectural review board, obtain its current material, color and drawing requirements before ordering. Confirm the applicable Town and association reviews for your address and scope. Ask who will prepare each submission and include that responsibility in the estimate; a first-pass approval cannot be guaranteed.",
      "For a waterfront pool or one using a salt system, ask the supplier about the exact material and treatment proposed. An impregnating treatment can improve stain resistance, but it does not establish immunity to salt or pool chemicals. Review drainage and movement at the pool edge separately from the surface finish.",
      "Changing the pool surround? Our <a href=\"/blog/pool-deck-pavers-jupiter/\">Jupiter pool-deck drainage guide</a> explains what to review before preparing the project plan.",
    ],
    localNote: "Bring the current design guidelines, if any, plus photos of poolside exposure and drainage. Agree the deck material, coping and required submissions before committing to the installation scope.",
    faqs: [
      { q: 'Will you handle the architectural review board approval for my Jupiter pool deck?', a: "Confirm whether your property requires an association review and what it needs for this scope. The estimate should name who prepares and submits the material details and drawings. Approval comes from the reviewing body; neither the outcome nor first-pass acceptance is guaranteed." },
      { q: 'Can you match the paver style my waterfront community requires on the deck?', a: "Bring the actual guidelines and compare samples for the permitted palette, format and coping. Check the proposed finish and treatment for wet poolside use as well as appearance. Confirm acceptance through the applicable review before ordering; the stone name alone is not a traction or barefoot-comfort rating." },
      { q: 'Does the Intracoastal salt and a salt system hurt a paver deck?', a: "A sealed deck is not automatically protected against salt and pool chemistry. Confirm the selected product and treatment for that exposure, and follow the supplier care instructions. If units have moved, investigate the base and drainage before proposing a reset; replacements may differ in appearance." },
      { q: 'What does a paver pool deck cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  'palm-beach-gardens': {
    lede: "For your Palm Beach Gardens pool deck, compare repair and replacement, material samples and any community design requirements before ordering.",
    intro: [
      'Replacing an existing deck? Read our <a href="/blog/pool-deck-replacement-palm-beach-gardens/">pool-deck replacement guide for Palm Beach Gardens</a> to compare removal with an overlay and prepare questions about finished heights, coping and drainage.',

      'Choosing a new finish? Read our guide to <a href="/blog/hoa-pool-deck-pavers-palm-beach-gardens/">HOA pool-deck review in Palm Beach Gardens</a> before submitting samples or changing an approved material.',

      "When updating a Palm Beach Gardens pool area, list the coping, enclosure, doors and drains you intend to retain. Those existing features help define the finished height and layout. Compare new samples beside them in the actual sun and shade; do not assume that a material name guarantees a comfortable surface temperature.",
      "If your community has design guidelines, obtain the current requirements for material, color, pattern and coping. Confirm the review process for your property before committing to a product. The estimate should explain who supplies the drawings and samples and which work depends on approval.",
      "Assess the base, drainage and edge conditions before choosing an overlay, reset or full replacement. Include the proposed finished heights and the transitions to the pool and house in the written scope. Confirm applicable city, association and pool-barrier requirements for the actual work rather than assuming every project follows the same review.",
    ],
    localNote: "Bring existing drawings and any community guidelines to the visit. Review material samples, coping, finished heights and approval responsibilities together so the estimate reflects the actual project.",
    faqs: [
      { q: 'Does my Palm Beach Gardens community have to approve the pool-deck design?', a: "Check your property documents and current community guidelines before choosing material, color, pattern or coping. If a review is required, confirm the submission contents and who prepares them. City and association requirements should be checked separately; a city name does not establish that every property needs the same approval." },
      { q: 'Our community pool deck is faded and uneven — replace or reset?', a: "First assess the cause of uneven areas and the condition of the pavers, base and pool edge. A local reset may be possible where units can be reused and the cause can be corrected. Ask which areas require replacement and how the finish will match; inspection is needed before promising the repair scope or appearance." },
      { q: 'Which stone stays coolest around a Gardens pool?', a: "Compare actual samples in the conditions where the deck will be used instead of choosing by the name travertine or marble alone. Ask for the supplier wet-use and care guidance for the specific finish and treatment. Neither a stone name nor a slip-test result guarantees comfort or prevents a slip." },
      { q: 'What does a paver pool deck cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  wellington: {
    lede: "For a larger Wellington pool deck, plan the walking routes, drainage and transitions to shade or outdoor-living areas before choosing the finish.",
    intro: [
      "For a Wellington pool deck on a larger lot, start with the area you use and the features you want to retain. Map the route between doors, the pool and any shade or outdoor kitchen. Compare actual material samples in the expected sun and wet conditions; travertine or marble alone does not establish barefoot comfort or traction.",
      "Include access for removal and delivery, the condition of the base and the deck edges in the assessment. Review where water collects and where it can drain before setting finished heights. The written scope should identify preparation and drainage work separately from the selected pavers and coping.",
      "A larger layout can be planned as connected zones, but it is not a promise that the surface will never crack or settle. Discuss movement, maintenance and any repair allowances before selecting a system. Confirm the applicable Village and association reviews, including any pool-barrier or structural work in the proposed scope.",
    ],
    localNote: "For a larger deck, bring a layout or survey showing doors, the pool, shade structures and equipment access. Identify drainage concerns and the features that will stay so the estimate can separate installation from additional repairs.",
    faqs: [
      { q: 'Can you build a large estate pool deck without it cracking across the span?', a: "No deck should be promised free from cracking or settlement. Base preparation, drainage, loading and site conditions need assessment. Individual pavers can sometimes be lifted for repair, but the cause of movement and whether the units can be reused determine the scope and result." },
      { q: 'Which material works best for a big Wellington pool deck people cross barefoot?', a: "Compare the proposed paver, color, finish and any treatment using samples and supplier guidance for wet poolside use. Plan for sun and shade and the way people will cross the area. A material name alone does not guarantee that the deck stays cool or that a wet surface cannot be slippery." },
      { q: 'Can you tie the pool deck into an outdoor kitchen or shade structure?', a: "Discuss the connection during the site visit, including finished heights, drainage and equipment access. Identify any separate foundations, utilities or structural work in the written scope. The estimate should distinguish the paver deck from work that needs a separate specialist or review." },
      { q: 'What does a paver pool deck cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  'west-palm-beach': {
  "lede": "Plan your pool deck around the home you have, including its architectural character, access and the condition of existing surfaces.",
  "intro": [
    "For a West Palm Beach pool deck, start with coping, door clearances, drainage, pool equipment and wet-use conditions. If your property in El Cid, Flamingo Park or another neighborhood has historic designation, check which features and materials need review before finalizing the design. A neighborhood name alone does not determine the age or requirements of an individual home.",
    "Before finalizing the deck footprint, coping and any pool-barrier changes, confirm the property address, historic status and any association requirements. The <a href=\"https://www.wpb.org/Departments/Development-Services/Planning-Division/Historic-Preservation/Historic-Preservation-FAQs\">City of West Palm Beach historic preservation guidance</a> explains the additional review for designated properties. Bring a survey, photos and any existing approval documents to the on-site visit so the estimate can reflect the work and review steps.",
    "Before choosing a layout, read our <a href=\"/blog/pool-deck-pavers-west-palm-beach/\">West Palm Beach pool-deck planning guide</a>, including questions about historic review.",
    "Surface temperature depends on the particular product, color, finish, sun exposure and weather. Compare samples at your property in the conditions you expect to use the area. A stone name alone does not guarantee barefoot comfort; plan shade and appropriate footwear as needed. Wet traction also depends on the selected surface, treatment and maintenance; ask for product guidance for poolside use. Individual pavers may be lifted and reset, but first identify the cause of movement and whether the units are reusable. Replacement units can differ in color and wear from the existing surface. Repair scope and the likely appearance should be agreed after inspection; an invisible repair is not guaranteed."
  ],
  "localNote": "Bring a survey, photos and any existing product or approval records. For this West Palm Beach pool deck, the estimate should explain coping, door clearances, drainage, pool equipment and wet-use conditions, what will be retained and any separate repair allowance.",
  "faqs": [
    {
      "q": "What deck material suits a historic El Cid or Flamingo Park pool?",
      "a": "Compare the color, format and coping with your home and the features you are retaining. Surface temperature depends on the particular product, color, finish, sun exposure and weather. Compare samples at your property in the conditions you expect to use the area. A stone name alone does not guarantee barefoot comfort; plan shade and appropriate footwear as needed."
    },
    {
      "q": "Which approvals apply to this work in West Palm Beach?",
      "a": "Approval depends on the specific property and work, even without an HOA. Check any required city permits and whether historic designation adds review. Discuss the deck footprint, coping and any pool-barrier changes with the City of West Palm Beach before work begins, and confirm any separate association requirements."
    },
    {
      "q": "Can you reset a deck that has heaved against an older pool shell?",
      "a": "Individual pavers may be lifted and reset, but first identify the cause of movement and whether the units are reusable. Replacement units can differ in color and wear from the existing surface. Repair scope and the likely appearance should be agreed after inspection; an invisible repair is not guaranteed."
    },
    {
      "q": "What does a paver pool deck cost?",
      "a": "It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
    }
  ]
},
  'delray-beach': {
  "lede": "For your Delray Beach pool deck, compare the existing condition, material options and maintenance needs before deciding what to replace.",
  "intro": [
    "For a Delray Beach home in Lake Ida, Del-Ida Park or near the coast, assess coping, door clearances, drainage, pool equipment and wet-use conditions at the actual property. Exposure, access and the condition of what you want to retain can differ from one lot to the next. An older surface does not by itself establish that full replacement is necessary.",
    "Before finalizing the deck footprint, coping and any pool-barrier changes, confirm the property address, historic status and any association requirements. The <a href=\"https://www.delraybeachfl.gov/government/city-departments/development-services/historic-preservation/historic-preservation-applications\">City of Delray Beach historic preservation guidance</a> explains the additional review for designated properties. Bring a survey, photos and any existing approval documents to the on-site visit so the estimate can reflect the work and review steps.",
    "Surface temperature depends on the particular product, color, finish, sun exposure and weather. Compare samples at your property in the conditions you expect to use the area. A stone name alone does not guarantee barefoot comfort; plan shade and appropriate footwear as needed. Wet traction also depends on the selected surface, treatment and maintenance; ask for product guidance for poolside use. Individual pavers may be lifted and reset, but first identify the cause of movement and whether the units are reusable. Replacement units can differ in color and wear from the existing surface. Repair scope and the likely appearance should be agreed after inspection; an invisible repair is not guaranteed."
  ],
  "localNote": "Bring a survey, photos and any existing product or approval records. For this Delray Beach pool deck, the estimate should explain coping, door clearances, drainage, pool equipment and wet-use conditions, what will be retained and any separate repair allowance.",
  "faqs": [
    {
      "q": "Does salt air near the Delray beach hurt a paver pool deck?",
      "a": "Salt exposure and moisture can affect both stone and concrete products. Select material and any treatment using the supplier instructions for the actual setting. Sealer can improve stain resistance but does not make a surface immune to salt, staining or wear. Cleaning and resealing depend on the product and observed condition."
    },
    {
      "q": "Which approvals apply to this work in Delray Beach?",
      "a": "Approval depends on the specific property and work, even without an HOA. Check any required city permits and whether historic designation adds review. Discuss the deck footprint, coping and any pool-barrier changes with the City of Delray Beach before work begins, and confirm any separate association requirements."
    },
    {
      "q": "Which deck material stays coolest by the beach?",
      "a": "Surface temperature depends on the particular product, color, finish, sun exposure and weather. Compare samples at your property in the conditions you expect to use the area. A stone name alone does not guarantee barefoot comfort; plan shade and appropriate footwear as needed."
    },
    {
      "q": "What does a paver pool deck cost?",
      "a": "It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
    }
  ]
},
  'boynton-beach': {
    lede: "For your Boynton Beach pool deck, assess uneven areas, drainage and access before comparing a reset with replacement.",
    intro: [
      'Planning a replacement? Our <a href="/blog/pool-deck-paver-replacement-estimate/">pool deck replacement estimate guide</a> helps you compare removal, preparation, retained features and responsibility for unexpected work.', 
      "Start your Boynton Beach pool-deck estimate with photos of the surface, coping, doors and equipment access. Mark the areas that have moved, show wear or collect water. Identify what you want to retain, then compare the repair scope with replacement instead of assuming that a waterfront location or the age of the home requires a new deck.",
      "Ground and drainage conditions need to be assessed at your property. A paver or sealer does not correct a weak base or standing water. For a pool using a salt system or exposed to coastal conditions, confirm the material, finish and any treatment with the supplier, including maintenance limits. Sealing is not a guarantee against salt or chemical damage.",
      "Bring any available survey, previous approvals and association guidelines. Confirm the applicable City and association requirements for the actual deck, coping, drainage and pool-barrier work. The written estimate should separate removal, preparation, new materials and any repairs to retained features, with review responsibilities identified.",
    ],
    localNote: "Show us the access route for removal and delivery as well as low spots and transitions at the pool edge. The estimate should distinguish base and drainage corrections from paver selection and ongoing care.",
    faqs: [
      { q: 'My Boynton pool backs onto the Intracoastal — does the water table matter for the deck?', a: "The ground and drainage matter, but the neighborhood alone does not establish the water table or base design. Point out wet or uneven areas for assessment. If settlement involves the pool shell or seawall, identify that separate issue before promising that resetting pavers will solve it." },
      { q: 'Is there an HOA approval step for a pool deck in Boynton Beach?', a: "Check the property documents and current association rules for your address, then confirm City requirements for the proposed scope. Do not assume that every deck repair requires the same permit or that a street is association-free. Identify the necessary submissions and who handles them in the estimate." },
      { q: 'Will a salt system and Intracoastal salt damage the deck?', a: "A sealer does not make every stone immune to salt or pool chemicals. Check the exact material, finish and treatment with the supplier for poolside use and follow the care guidance. Reusable pavers may be reset after the cause of movement is addressed; replacement pieces may differ in color and wear, so an invisible repair is not guaranteed." },
      { q: 'What does a paver pool deck cost?', a: 'It depends on size, material and site prep, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
