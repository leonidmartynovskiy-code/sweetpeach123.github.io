---
import LocalServiceTemplate from '../../../components/LocalServiceTemplate.astro';
import { CITIES, type City } from '../../../data/cities';

export function getStaticPaths() {
  return CITIES.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };

const SERVICE = { name: 'Paver cleaning & sealing', label: 'Clean & seal', slug: 'clean-seal' };

const SERVICES = [
  { label: 'Driveways', slug: 'driveways' },
  { label: 'Walkways', slug: 'walkways' },
  { label: 'Patios', slug: 'patios' },
  { label: 'Pool decks', slug: 'pool-decks' },
  { label: 'Outdoor living', slug: 'outdoor-living' },
  { label: 'Retaining & seating walls', slug: 'retaining-seating-walls' },
  { label: 'Natural stone', slug: 'natural-stone' },
  { label: 'Clean & seal', slug: 'clean-seal' },
];
const CITY_CHIPS = CITIES.map((c) => ({ label: c.name, slug: c.slug }));

// ---- Per-city clean & seal copy (uniquely written off each city's real differentiators) ----
interface Local { lede: string; intro: string[]; localNote: string; faqs: { q: string; a: string }[]; }
const LOCAL: Record<string, Local> = {
  "boca-raton": {
    "lede": "Paver cleaning and sealing in Boca Raton starts with a surface assessment, so stains, worn coating and loose joints receive the treatment they need.",
    "intro": [
      "For a Boca Raton driveway or pool deck, show us where the surface stays damp, which marks return after cleaning and whether any pavers have moved. Those observations help separate cleaning needs from repairs. A coastal address alone does not establish the cause of a stain or the condition of the base.",
      "The estimate should identify the paver material, existing coating and areas needing joint sand. Cleaning and compatible joint treatment can improve the surface, but do not guarantee permanently weed-free or ant-free joints. Uneven pavers and drainage concerns need a separate assessment.",
      "Choose the finish on a representative trial area rather than assuming matte and wet-look products offer identical protection. For a pool deck, ask about the selected product's suitability for wet foot traffic. Read our <a href=\"/blog/paver-sealer-finish-test/\">guide to reviewing a paver sealer test area</a> before agreeing on the appearance."
    ],
    "localNote": "For your Boca Raton site visit, bring any previous sealer information and note shaded or frequently wet sections. Ask your association about the proposed finish if community rules apply.",
    "faqs": [
      {
        "q": "How often should I reseal my pavers in Boca Raton?",
        "a": "Use the selected manufacturer's maintenance guidance and inspect the existing finish. Product, traffic, exposure and surface condition all matter; a coastal address does not establish one resealing interval for every property."
      },
      {
        "q": "Will cleaning and re-sanding stop all weeds and ants?",
        "a": "Suitable joint treatment can reduce sand loss and the potential for weeds and insects. It does not make the joints maintenance-free. The proposed product must suit the joint width, paver material and site conditions."
      },
      {
        "q": "Should I choose matte or wet-look sealer for my Boca pool deck?",
        "a": "Compare a cured trial on your own material, including its appearance and wet traction. Matte and wet-look describe appearance, not equivalent protection or slip resistance. Confirm compatibility with any existing coating before selecting a product."
      },
      {
        "q": "What does paver cleaning and sealing cost?",
        "a": "It depends on the square footage and the condition of the pavers, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
      }
    ]
  },
  "jupiter": {
    "lede": "For Jupiter paver driveways and pool decks, assess stains, joint condition and existing sealer before choosing cleaning, repairs or a new finish.",
    "intro": [
      "If your Jupiter community has appearance rules, bring the current requirements and the finish you want to the assessment. A uniform streetscape does not mean every driveway has the same pavers, coating or wear. Cleaning and sealing cannot promise an exact match to neighboring surfaces.",
      "Point out loose units, settlement and areas that hold water before the cleaning scope is priced. The age of a driveway cannot confirm that its base is sound. Any necessary repair should be identified separately from cleaning, joint maintenance and sealing.",
      "A trial area helps compare the proposed cleaning result and finish with the existing surface. Review our <a href=\"/blog/paver-sealer-finish-test/\">sealer finish test-area guide</a>, then record the agreed product and appearance in the scope. Compatible joint treatment can reduce sand loss and weed growth, but ongoing maintenance remains necessary."
    ],
    "localNote": "For a Jupiter property with community design rules, check the proposed color or sheen with the association before scheduling. Provide any known existing-product details so coating compatibility can be assessed.",
    "faqs": [
      {
        "q": "Does my Jupiter community require approval to reseal pavers?",
        "a": "Ask your own association or design committee about the proposed work and finish. Requirements cannot be inferred from a community name. If repairs or changes to the surface are included, confirm the applicable city requirements for that scope as well."
      },
      {
        "q": "Can resealing make unevenly faded pavers match again?",
        "a": "Cleaning and a suitable sealer may improve appearance, but wear, stains and old coatings can leave differences. Review a representative trial; do not assume the result will be uniform or match the rest of the street."
      },
      {
        "q": "Will re-sanding stop weeds in my driveway?",
        "a": "Joint stabilization can help retain sand and reduce weed growth. It does not guarantee weed-free or ant-free joints, and it cannot repair settlement or increase the pavement's load capacity."
      },
      {
        "q": "What does paver cleaning and sealing cost?",
        "a": "It depends on the square footage and the condition of the pavers, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
      }
    ]
  },
  'palm-beach-gardens': {
    lede: 'Cleaning and sealing starts with the condition of your Palm Beach Gardens pavers: surface stains, joint sand, uneven areas and any existing coating need separate attention.',
    intro: [
      'Have stone borders or coping beside concrete pavers? Our <a href="/blog/cleaning-stone-and-concrete-pavers/">mixed-surface cleaning guide</a> explains why each material needs its own treatment plan.', 
      'Before booking, compare <a href="/blog/paver-cleaning-repair-palm-beach-gardens/">paver cleaning with repairs for uneven surfaces and drainage problems</a> so the estimate covers the work your driveway needs.',
      'For orange or brown marks, read <a href="/blog/rust-stains-pavers-before-sealing/">what to check about suspected rust stains before sealing</a>, including material identification and a trial area.',
      'Before selecting the final appearance, see <a href="/blog/paver-sealer-finish-test/">how to review a sealer finish on a small test area</a> and record your expectations for the work.',
      'Planning access during the work? Read <a href="/blog/using-driveway-after-paver-sealing/">how to arrange parking and reopen your driveway after sealing</a> before choosing a start date.',  
      'A faded or stained driveway does not tell us whether its base is sound. Point out sinking pavers, movement and standing water at the site visit so repair or drainage work can be assessed separately from surface cleaning. Cleaning and sealer cannot correct an underlying structural problem.',
      'The proposed cleaning method, joint material and sealer should suit the pavers and any existing coating. A small trial area helps check cleaning results and the proposed finish before treating the full surface. Joint stabilization can help retain sand and reduce weed growth, but it does not eliminate routine maintenance or guarantee weed-free and ant-free joints.',
      'A sealer may enhance color or change the sheen; it cannot promise a like-new surface or an exact match to neighboring pavers. For concrete pavers, <a href="https://www.cmha.org/resource/pav-tec-005/">CMHA cleaning, sealing and joint-sand guidance</a> explains product selection, trial areas and maintenance. Other materials need their own manufacturer guidance.',
    ],
    localNote: 'If your Palm Beach Gardens property has community design rules, check the current requirements for the proposed finish before work starts. Bring those requirements and any information about the existing coating to the site visit.',
    faqs: [
      { q: 'Do I need community approval to clean and seal my Palm Beach Gardens pavers?', a: 'Check with your own association or design committee before scheduling the work. We cannot infer its current requirements from the city or community name. Ask specifically about a proposed change in color or sheen, including a wet-look finish.' },
      { q: 'Our community pavers are faded and streaky - will sealing fix that?', a: 'First identify whether the uneven appearance comes from dirt, stains, wear or an existing coating. Cleaning and a suitable sealer may improve appearance, but an even color or a like-new finish is not guaranteed. Review a trial area before choosing the treatment.' },
      { q: 'How often will I need to reseal here?', a: 'The interval depends on the selected product, traffic, exposure and the condition of the existing coating. Follow the manufacturer guidance and assess the surface before recoating rather than assuming one schedule fits every Palm Beach Gardens driveway.' },
      { q: 'What does paver cleaning and sealing cost?', a: 'It depends on the square footage and the condition of the pavers, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline.' },
    ],
  },
  "wellington": {
    "lede": "Plan cleaning and sealing for your Wellington driveway or pool deck around its actual condition, access needs and vehicle use.",
    "intro": [
      'Planning around rain or irrigation? Our <a href="/blog/paver-sealing-weather-window/">sealing weather and surface-readiness guide</a> explains the questions to ask before confirming the work date.', 
      "For a long Wellington driveway or several connected outdoor areas, identify which sections need cleaning, joint work or repairs. Note how vehicles will reach the property while work takes place. The written scope should distinguish the driveway, apron and pool deck instead of assuming they need identical treatment.",
      "If trucks or trailers use the driveway, show us any movement, rutting or recurring sand loss. Joint stabilization does not increase the pavement's load-bearing capacity. Cleaning and sealer cannot substitute for correcting a base, edge or drainage problem.",
      "Ask for the selected product's return-to-use instructions and a plan for access during curing. A <a href=\"/blog/paver-sealer-finish-test/\">representative sealer test area</a> helps set finish expectations, but does not guarantee an identical appearance across surfaces with different materials or wear."
    ],
    "localNote": "For a Wellington property used by trucks or trailers, include the vehicle use and access constraints in the estimate request. Assess the driveway and pool deck separately before setting a maintenance schedule.",
    "faqs": [
      {
        "q": "Can a large Wellington driveway and pool deck be assessed together?",
        "a": "Include both in the site-visit request. The estimate can identify each area, its condition, the proposed treatment and any access or phasing needs. A single property does not mean every surface should receive the same product."
      },
      {
        "q": "Will polymeric sand fix joints affected by trucks and trailers?",
        "a": "A compatible joint treatment may help retain sand, but first identify why the joints are losing material or the pavers are moving. Stabilized sand does not add structural capacity; vehicle-related settlement may require repair."
      },
      {
        "q": "Should my pool deck and driveway follow the same resealing schedule?",
        "a": "Not automatically. Traffic, moisture, coating condition and the selected product can differ. Inspect each surface and follow its manufacturer guidance rather than assigning a fixed interval by surface type."
      },
      {
        "q": "What does paver cleaning and sealing cost?",
        "a": "It depends on the square footage and the condition of the pavers, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
      }
    ]
  },
  "west-palm-beach": {
    "lede": "Clean and seal your West Palm Beach pavers with a scope that respects the existing material, desired finish and any property-specific review requirements.",
    "intro": [
      'Seeing low or repeatedly empty joints? Use our <a href="/blog/paver-joint-sand-before-sealing/">joint-sand assessment guide</a> to discuss the cause and the proposed treatment before sealing.', 
      "For an older West Palm Beach driveway or walkway, identify the material and previous coating before choosing a cleaning method. A warm color does not tell us whether the units are clay, concrete or stone. Worn surfaces and repaired sections may respond differently to the same treatment.",
      "Use a trial area to review the cleaning result and proposed sheen. The <a href=\"/blog/paver-sealer-finish-test/\">sealer finish test-area guide</a> explains what to discuss before treating the full surface. Cleaning and sealing may improve appearance, but cannot promise a period-correct color or hide every stain and repair.",
      "For a designated historic property or a home within a historic district, ask city historic-preservation staff how the proposed work is classified before proceeding. The city's <a href=\"https://www.wpb.org/Departments/Development-Services/Planning-Division/Historic-Preservation/Historic-Preservation-FAQs\">Historic Preservation FAQs</a> explain that review depends on the work. Do not assume that cleaning, a finish change and replacing pavers have the same review requirements."
    ],
    "localNote": "If historic-district or association rules apply to your West Palm Beach property, bring the relevant requirements to the site visit. Identify recurring damp spots and previous repairs so the cleaning scope addresses the surface you actually have.",
    "faqs": [
      {
        "q": "Will a wet-look sealer suit my historic West Palm Beach home?",
        "a": "Review a trial on the actual material and discuss the proposed appearance with the relevant reviewer if the property is designated or subject to community rules. A finish name alone cannot establish compatibility or an appropriate result."
      },
      {
        "q": "Will sealing stop growth returning under shaded trees?",
        "a": "Cleaning can address existing surface buildup, but sealing is not a guarantee against recurring growth. Point out persistent dampness or standing water, assess the cause and plan ongoing cleaning appropriate to the material and coating."
      },
      {
        "q": "Do I need approval for work on pavers in a historic district?",
        "a": "Confirm the property's status and proposed scope with West Palm Beach historic-preservation staff before work starts. Cleaning, coating changes and replacement can be different scopes. This page does not establish an exemption or say that every cleaning job requires the same approval."
      },
      {
        "q": "What does paver cleaning and sealing cost?",
        "a": "It depends on the square footage and the condition of the pavers, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
      }
    ]
  },
  "delray-beach": {
    "lede": "For Delray Beach pavers, separate stain removal, joint maintenance and any repairs before choosing whether to seal the surface.",
    "intro": [
      "Tell us where marks recur on your Delray Beach driveway or pool deck and whether they follow irrigation, cleaning or rain. Surface appearance alone cannot identify a stain's source or prove that the base is sound. Note uneven units and standing water separately from cosmetic concerns.",
      "The cleaning method should suit the material and existing coating, with a trial to check the result. Re-sanding or stabilization may help retain joint material, but repeated washout needs an assessment of the water path. Sealer does not correct drainage and cannot promise a like-new surface.",
      "Before selecting matte or wet-look, compare the proposed appearance using our <a href=\"/blog/paver-sealer-finish-test/\">guide to a cured sealer test area</a>. Ask what upkeep the selected product requires; the property's distance from the beach is not enough to set a recoating date."
    ],
    "localNote": "At a Delray Beach assessment, identify irrigation stains, frequently wet areas and repeated joint washout. Those site observations are more useful for choosing a treatment than assuming every coastal surface has the same problem.",
    "faqs": [
      {
        "q": "How often should I reseal pavers near the Delray beach?",
        "a": "Inspect the coating and follow the selected product's guidance for the surface and its use. Sun, traffic and moisture conditions vary; there is no single interval established here for all coastal properties."
      },
      {
        "q": "Can cleaning and sealing permanently remove dark growth on a pool deck?",
        "a": "First assess the buildup and choose a material-compatible cleaning method. Results and recurrence depend on the surface and conditions. Sealing does not guarantee permanent removal or replace routine cleaning and attention to persistent moisture."
      },
      {
        "q": "What if rain keeps washing sand out of the joints?",
        "a": "Identify the water path and any drainage or edge problem before selecting a compatible joint treatment. Stabilization can reduce sand loss, but it does not make the surface immune to washout or fix the cause of standing water."
      },
      {
        "q": "What does paver cleaning and sealing cost?",
        "a": "It depends on the square footage and the condition of the pavers, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
      }
    ]
  },
  "boynton-beach": {
    "lede": "Request a condition-based cleaning and sealing assessment for your Boynton Beach pavers, with joint work and repairs identified separately.",
    "intro": [
      "For a Boynton Beach driveway, patio or pool deck, start with what you can observe: stained sections, loose joint material, peeling coating or pavers that have moved. A waterfront location does not prove the cause of a mark or determine which sealer will suit the surface.",
      "The proposed cleaning treatment should match the paver material and any existing coating. Joint maintenance can help retain sand and reduce weed growth, but is not a permanent barrier to weeds or ants. Point out low areas and standing water because sealing cannot correct drainage or repair settlement.",
      "Use our <a href=\"/blog/paver-sealer-finish-test/\">paver sealer finish test guide</a> to prepare questions about the proposed appearance. Include the areas to be treated, known coating history and recurring problems in your estimate request so the site visit can address them."
    ],
    "localNote": "For Boynton Beach properties near the Intracoastal, describe the actual moisture and maintenance conditions at your home. Choose the product and upkeep plan from a surface assessment, not from the waterfront address alone.",
    "faqs": [
      {
        "q": "How often should I reseal pavers at my Boynton waterfront home?",
        "a": "Follow the selected product's maintenance guidance and inspect the current coating. Traffic, exposure and material affect the decision. A waterfront address alone does not justify a fixed two- or three-year schedule."
      },
      {
        "q": "Will sealing stop recurring growth near damp areas?",
        "a": "Cleaning can remove surface buildup, but a sealer does not guarantee that it will not return. Identify persistent moisture or drainage concerns and maintain the surface using methods compatible with the pavers and coating."
      },
      {
        "q": "What can be done about weeds and ants in the joints?",
        "a": "Assess the joint condition and select compatible sand or stabilization where appropriate. This can reduce sand loss and the potential for weeds and insects, but does not remove the need for regular maintenance."
      },
      {
        "q": "What does paver cleaning and sealing cost?",
        "a": "It depends on the square footage and the condition of the pavers, which is why the on-site visit and written estimate are free and itemized. Financing through Wisetack is available so the budget does not decide the timeline."
      }
    ]
  },
};

const local = LOCAL[city.slug];
const permit = city.permitAuthority.replace('the ', '').replace(/^./, (m) => m.toUpperCase());
const handles = [
  'Surface and stain assessment, with a trial area for the proposed cleaning treatment',
  'Joint-sand assessment and compatible re-sanding or stabilization where needed',
  'Sealer selection based on the paver material, existing coating and intended finish',
];

const data = {
  seoTitle: `Paver Cleaning & Sealing in ${city.name}, FL · Perfect Pavers`,
  seoDescription: city.slug === 'palm-beach-gardens' ? 'Paver cleaning and sealing in Palm Beach Gardens. Assess stains, joints, uneven areas and existing coatings before choosing a treatment. Free on-site visit.' : `Paver cleaning and sealing in ${city.name}. Assess stains, joints and existing coatings, with repairs considered separately. Request a free on-site visit.`,
  service: SERVICE,
  city,
  lede: local.lede,
  intro: local.intro,
  localNote: local.localNote,
  approvalsLabel: city.slug === 'west-palm-beach' ? 'Confirm city / association requirements' : undefined,
  handles,
  faqs: local.faqs,
  heroImg: '/images/local-hero-clean-seal.jpg',
  heroAlt: 'Paver surface shown as a cleaning and sealing example',
  heroBg: '/images/local-hero-clean-seal.jpg',
  services: SERVICES,
  cities: CITY_CHIPS,
};
---
<LocalServiceTemplate {...data} />
