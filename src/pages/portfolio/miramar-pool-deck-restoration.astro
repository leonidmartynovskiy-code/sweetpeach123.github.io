---
import PortfolioPlanningGuide from '../../components/PortfolioPlanningGuide.astro';
const guide = {
  "title": "Planning pool deck paver repairs and maintenance",
  "description": "Separate uneven-paver repairs, cleaning and sealing when requesting a pool deck assessment.",
  "service": "/services/clean-seal/",
  "serviceLabel": "Cleaning and sealing",
  "sections": [
    [
      "Identify the areas that need assessment",
      "Photograph uneven pavers, damaged units, open joints and water concerns around the pool. Show transitions to coping, steps and doors. Ask the contractor to distinguish a surface maintenance concern from an area needing repair or further investigation."
    ],
    [
      "Keep repair and maintenance scopes separate",
      "Cleaning and sealing do not reset an uneven surface. If lifting or resetting pavers is recommended, ask the proposal to identify the affected area, preparation, replacement material needs and responsibilities before maintenance begins."
    ],
    [
      "Check the surface history",
      "Tell the contractor about previous sealers, cleaning treatments and repairs, including products or dates when known. Ask which assessment or test area is appropriate for the material and proposed treatment. Do not assume every stain or coating can be removed with the same process."
    ],
    [
      "Plan access and reopening",
      "Agree on pool protection, access routes and the work sequence. Ask for product-specific drying and reopening instructions and how weather can affect the schedule. This guide describes questions for a site visit, not a completed restoration or a guaranteed finish."
    ]
  ]
};
---
<PortfolioPlanningGuide {...guide} />
