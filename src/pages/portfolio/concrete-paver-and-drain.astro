---
import PortfolioPlanningGuide from '../../components/PortfolioPlanningGuide.astro';
const guide = {
  "title": "Planning a paver driveway and drainage scope",
  "description": "Questions to separate a new paver driveway surface, drainage assessment and adjoining work in your estimate.",
  "service": "/services/driveways/",
  "serviceLabel": "Paver driveway installation",
  "sections": [
    [
      "Record the current surface and water concerns",
      "Bring photographs of the driveway, garage threshold, sidewalk and street connection. Note where you have observed standing or flowing water and when it occurs. A photograph of another installation cannot determine an appropriate drainage solution for your property."
    ],
    [
      "Separate assessment from construction",
      "Ask who will assess the existing elevations and drainage route and what information is needed before recommending a change. The written scope should identify any proposed drainage work separately from paver removal, base preparation and surface installation."
    ],
    [
      "Describe transitions and responsibilities",
      "Identify retained drains, utilities, landscaping and adjoining surfaces. Ask which items will be protected, moved, replaced or restored, and who is responsible for work outside the paver installation. Confirm applicable municipal and association requirements for the proposed scope."
    ],
    [
      "Compare itemized proposals",
      "Compare the same material, measured area, preparation and restoration items. Record exclusions, access needs and scheduling assumptions. Request a site-specific estimate; no price, completion time or drainage outcome can be established from this planning guide."
    ]
  ]
};
---
<PortfolioPlanningGuide {...guide} />
