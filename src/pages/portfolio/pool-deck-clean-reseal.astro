---
import PortfolioPlanningGuide from '../../components/PortfolioPlanningGuide.astro';
const guide = {
  "title": "Preparing a concrete paver maintenance estimate",
  "description": "Separate cleaning, joint maintenance, coating preparation and repairs when requesting an estimate for existing concrete pavers.",
  "service": "/services/clean-seal/",
  "serviceLabel": "Paver cleaning and sealing",
  "sections": [
    [
      "Record the existing surface",
      "Bring photographs of the whole area and the specific stains, loose joints or uneven units you want assessed. Identify the surface material and any known coating history. A photograph of another property cannot establish the condition of your own installation."
    ],
    [
      "Compare the proposed tasks",
      "Ask for cleaning, joint replenishment and any proposed coating to be itemized separately. Identify repairs, old-coating removal and stain treatment when they are part of the assessment. Ask what is excluded and which findings would require a revised estimate."
    ],
    [
      "Agree on a trial and appearance",
      "Discuss whether a small test is appropriate before treating the whole area. Ask how its result will be reviewed and how the proposed product relates to the existing surface. A sample or finished photograph does not guarantee the result on another property."
    ],
    [
      "Plan access and acceptance",
      "Agree who tells the household when pedestrian and vehicle access can resume, using the selected product instructions and actual site conditions. Keep the written scope, product details and aftercare instructions together. This guide does not establish a project price, a standard curing time or a completed-work record."
    ]
  ]
};
---
<PortfolioPlanningGuide {...guide} />
