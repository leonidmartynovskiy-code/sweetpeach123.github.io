---
import PortfolioPlanningGuide from '../../components/PortfolioPlanningGuide.astro';
const guide = {
  "title": "Planning paver driveway cleaning and sealing",
  "description": "Prepare a driveway maintenance request with surface history, repair concerns and product-specific care questions.",
  "service": "/services/clean-seal/",
  "serviceLabel": "Cleaning and sealing",
  "sections": [
    [
      "Describe the maintenance concern",
      "Photograph the driveway and mark the areas with stains, uneven units or joint concerns. Identify the surface material if known. Tell the contractor whether the goal is routine cleaning, assessment of a coating or investigation of damage."
    ],
    [
      "Bring the coating history",
      "Share any known sealer name, application date and earlier cleaning treatment. Ask how compatibility and readiness will be assessed, and whether a trial area is appropriate. Water appearance alone does not establish which product should be applied."
    ],
    [
      "Confirm what the estimate includes",
      "Have cleaning, joint work, any repairs and a proposed sealer described separately. Ask what is excluded and what observations could require an updated scope. Maintenance should not be presented as a substitute for correcting an underlying construction issue."
    ],
    [
      "Plan vehicles and aftercare",
      "Discuss access, protection of adjoining surfaces and where vehicles can stay during work. Follow the selected product and contractor instructions for drying and reopening. This guide does not establish a standard price, duration or outcome for your driveway."
    ]
  ]
};
---
<PortfolioPlanningGuide {...guide} />
