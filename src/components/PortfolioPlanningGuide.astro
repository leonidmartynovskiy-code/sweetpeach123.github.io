---
import BaseLayout from '../layouts/BaseLayout.astro';
const {title, description, service, serviceLabel, sections} = Astro.props;
const breadcrumbLd = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:'Home',item:new URL('/',Astro.site).href},
  {'@type':'ListItem',position:2,name:'Portfolio',item:new URL('/portfolio/',Astro.site).href},
  {'@type':'ListItem',position:3,name:title,item:new URL(Astro.url.pathname,Astro.site).href},
]};
---
<BaseLayout title={`${title} | Perfect Pavers of Palm Beach`} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />
  <article class="block wrap planning-guide">
    <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/portfolio/">Portfolio</a> / Planning guide</nav>
    <p class="eyebrow">Project planning guide</p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <p class="guide-note">This page provides planning information, not a record or photo gallery of completed work by Perfect Pavers of Palm Beach.</p>
    {sections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}
    <section><h2>Discuss your property</h2><p>Review our <a href={service}>{serviceLabel.toLowerCase()}</a> service and bring your questions to a site visit. We can discuss the requested work and what information is needed for a property-specific proposal.</p>
      <div class="guide-actions"><a href="/contact/" class="btn btn-brass">Request an estimate</a><a href="tel:+15618348880" class="btn btn-ghost">Call (561) 834-8880</a></div>
    </section>
  </article>
  <style>
    .planning-guide{max-width:900px;overflow-wrap:anywhere}
    nav{font-size:14px;margin-bottom:30px;color:var(--muted)}
    h1{font-size:clamp(32px,5vw,52px);line-height:1.12;margin:14px 0 20px}
    .lede{font-size:20px;line-height:1.6}.guide-note{background:var(--ivory-2);padding:18px;border-left:3px solid var(--brass);margin-top:22px}
    section{margin-top:32px}h2{font-size:26px;margin-bottom:12px}p{line-height:1.75}
    p a,nav a{text-decoration:underline;text-underline-offset:3px}
    .guide-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
  </style>
</BaseLayout>
