---
import InquiryJourney from '../components/InquiryJourney.astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  canonical?: string;
  image?: string;        // absolute URL for social share previews
}

const {
  title = 'Perfect Pavers of Palm Beach',
  description = 'Premium paver driveways, pool decks, patios and outdoor living across Palm Beach County. State Certified General Contractor, CMHA certified, 35+ years in South Florida.',
  bodyClass = '',
  canonical,
  image,
} = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <InquiryJourney />
<script is:inline>
/* Optional journey measurement; no form data or acquisition-source overrides. */
(function () {
  var measurementId = 'G-VEPMNPCFF3';
  var visit = window.ppInquiryVisit || {};
  function path(value, pattern) {
    if (typeof value !== 'string' || !value) return '';
    try {
      var url = new URL(value, window.location.origin);
      if (url.origin !== window.location.origin || !pattern.test(url.pathname)) return '';
      // Send only a short public path, never query strings, fragments or form fields.
      return url.pathname.length <= 100 ? url.pathname : '';
    } catch (_) { return ''; }
  }
  var articlePattern = /^\/blog\/[a-z0-9-]+\/$/;
  var servicePattern = /^\/services\/[a-z0-9-]+\/(?:[a-z0-9-]+\/)?$/;
  var article = path(visit.article, articlePattern);
  var service = path(visit.service, servicePattern);
  var pendingKey = 'pp_service_click_v1';
  // Hand off normal same-tab clicks across navigation; an unload-time event can be lost.
  try {
    var pending = JSON.parse(window.sessionStorage.getItem(pendingKey) || 'null');
    window.sessionStorage.removeItem(pendingKey);
    if (pending && Number.isFinite(pending.at) && Date.now() >= pending.at &&
        Date.now() - pending.at < 60000 &&
        path(pending.destination, servicePattern) === window.location.pathname) {
      var pendingParams = { send_to: measurementId, inquiry_service: window.location.pathname };
      var pendingArticle = path(pending.article, articlePattern);
      if (pendingArticle) pendingParams.origin_article = pendingArticle;
      window.ppPendingServiceEvent = pendingParams;
    }
  } catch (_) { /* Measurement must work without access to storage. */ }
  var params = {};
  if (article) params.origin_article = article;
  if (service) params.inquiry_service = service;
  // BaseLayout supplies these before its one automatic page_view.
  // The existing GA generate_lead rule copies them from the confirmation page_view.
  window.ppInquiryAnalyticsParams = params;

  document.addEventListener('click', function (event) {
    if (event.button !== 0 || !(event.target instanceof Element)) return;
    var link = event.target.closest('a[href]');
    if (!link) return;
    var destination = path(link.href, servicePattern);
    if (!destination || destination === window.location.pathname || typeof window.gtag !== 'function') return;
    var clickParams = { send_to: measurementId, inquiry_service: destination };
    if (article) clickParams.origin_article = article;
    var sameTab = !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey &&
      (!link.target || link.target === '_self') && !link.hasAttribute('download');
    if (sameTab) {
      try {
        window.sessionStorage.setItem(pendingKey, JSON.stringify({ destination: destination, article: article, at: Date.now() }));
        return;
      } catch (_) { /* Best-effort direct event if storage is unavailable. */ }
    }
    // Do not delay, intercept or rewrite navigation to send telemetry.
    window.gtag('event', 'service_click', clickParams);
  }, true);
})();
</script>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-VEPMNPCFF3"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-VEPMNPCFF3', window.ppInquiryAnalyticsParams || {});
    if (window.ppPendingServiceEvent) gtag('event', 'service_click', window.ppPendingServiceEvent);
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Perfect Pavers of Palm Beach" />
  {image && <meta property="og:image" content={image} />}
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Perfect Pavers of Palm Beach",
    "url": "https://paversofpalmbeach.com/"
  })} />
  <slot name="head" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://backend.leadconnectorhq.com" />
  <!-- Load web fonts without blocking first paint (font-display:swap keeps text visible) -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet" /></noscript>
  <script is:inline>
    // Enable scroll-reveal before first paint (skip if user prefers reduced motion)
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('reveal-ready');
    }
  </script>
</head>
<body class={bodyClass}>
  <Header />
  <slot />
  <Footer />

  <button id="toTop" class="to-top" aria-label="Back to top" hidden>↑</button>
  <script is:inline>
    (function () {
      var btn = document.getElementById('toTop');
      if (!btn) return;
      var shown = false;
      btn.hidden = false;
      function onScroll() {
        var should = window.scrollY > 400;
        if (should !== shown) { shown = should; btn.classList.toggle('is-vis', should); }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      var smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
      });
    })();
  </script>

  <!-- GoHighLevel Number Pool: session-based dynamic phone-number tracking (loads on every page) -->
  <script is:inline defer src="https://backend.leadconnectorhq.com/appengine/loc/6O64IBH8EOdqNTcAlwLR/pool/hqUY5RAYaK7ku7HEoILc/number_pool.js"></script>
  <script is:inline defer src="https://backend.leadconnectorhq.com/appengine/js/user_session.js"></script>

  <script is:inline>
    (function () {
      if (!document.documentElement.classList.contains('reveal-ready')) return;
      var sels = ['.trust .cell', '.props .card', '.steps .step', '.promise li', '.incl-list li', '.rev-grid > div', '.cities li', '.svc-intro-stats .sis', '.sec-head', '.services .svc', '.pf-grid .pf', '.port-grid .pcard', '.promise > .wrap > div:first-child', '.area > .wrap > div:first-child', '.cta .wrap', '.fin'];
      var items = [];
      sels.forEach(function (sel) {
        var els = document.querySelectorAll(sel);
        var counts = new Map();
        els.forEach(function (el) {
          var p = el.parentElement;
          var i = counts.get(p) || 0;
          counts.set(p, i + 1);
          el.style.transitionDelay = (i * 85) + 'ms';
          items.push(el);
        });
      });
      // Once an item has revealed, drop its stagger delay so hover highlights
      // fire instantly instead of waiting out the reveal delay.
      function clearDelay(el) {
        el.addEventListener('transitionend', function once() {
          el.style.transitionDelay = '0ms';
          el.removeEventListener('transitionend', once);
        });
      }
      if (!('IntersectionObserver' in window)) {
        items.forEach(function (el) { el.classList.add('is-in'); el.style.transitionDelay = '0ms'; });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { clearDelay(e.target); e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
